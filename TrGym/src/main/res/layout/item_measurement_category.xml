<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/lightGray"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Contenuto principale -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nome categoria -->
            <TextView
                android:id="@+id/textCategoryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peso"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ios_label"
                tools:text="Peso" />

            <!-- Ultimo valore -->
            <TextView
                android:id="@+id/textLatestValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75.2 kg"
                android:textSize="16sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp"
                tools:text="75.2 kg" />

            <!-- Info aggiuntive -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/textMeasurementCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 misurazioni"
                    android:textSize="12sp"
                    android:textColor="@color/ios_secondaryLabel"
                    tools:text="12 misurazioni" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="@color/ios_secondaryLabel" />

                <TextView
                    android:id="@+id/textLatestDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oggi"
                    android:textSize="12sp"
                    android:textColor="@color/ios_secondaryLabel"
                    tools:text="15/08/2025" />

            </LinearLayout>

        </LinearLayout>

        <!-- Pulsante aggiungi -->
        <ImageView
            android:id="@+id/btnAddMeasurement"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/circle_button_background"
            android:backgroundTint="@color/primary"
            app:tint="@color/white"
            android:padding="6dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>