<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/lightGray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Contenuto principale -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Valore -->
            <TextView
                android:id="@+id/textValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75.2 kg"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                tools:text="75.2 kg" />

            <!-- Data -->
            <TextView
                android:id="@+id/textDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15/08/2025 14:30"
                android:textSize="12sp"
                android:textColor="@color/ios_secondaryLabel"
                android:layout_marginTop="2dp"
                tools:text="15/08/2025 14:30" />

            <!-- Note (visibili solo se presenti) -->
            <TextView
                android:id="@+id/textNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dopo allenamento"
                android:textSize="12sp"
                android:textColor="@color/ios_label"
                android:textStyle="italic"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                tools:text="Dopo allenamento"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Pulsanti azione -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="12dp">

            <!-- Pulsante modifica -->
            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_edit"
                android:background="@drawable/circle_button_background"
                android:backgroundTint="@color/primary"
                app:tint="@color/white"
                android:padding="6dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Pulsante elimina -->
            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_delete"
                android:background="@drawable/circle_button_background"
                android:backgroundTint="@android:color/holo_red_dark"
                app:tint="@color/white"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>