<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.torto.trgym.ui.auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_down" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.torto.trgym.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_exercises"
            app:destination="@id/exercisesFragment"
            app:restoreState="true"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_down" />
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment"
            app:restoreState="true"
            app:enterAnim="@anim/slide_in_up"
            app:popEnterAnim="@anim/fade_in" />
        <action
            android:id="@+id/action_home_to_workoutDetail"
            app:destination="@id/workoutDetailFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_down"  />
        <action
            android:id="@+id/action_homeFragment_to_activeWorkoutFragment"
            app:destination="@id/activeWorkoutFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_down"
            />


    </fragment>

    <!-- Workout Detail Fragment -->
    <fragment
        android:id="@+id/workoutDetailFragment"
        android:name="com.torto.trgym.ui.workout.WorkoutDetailFragment"
        tools:layout="@layout/fragment_workout_detail">
        <argument
            android:name="workoutCardId"
            app:argType="string" />
        <action
            android:id="@+id/action_workoutDetailFragment_to_exerciseDetailFragment"
            app:destination="@id/exerciseDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_workoutDetailFragment_to_activeWorkoutFragment"
            app:destination="@id/activeWorkoutFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/slide_out_down"
            app:popEnterAnim="@anim/slide_in_down"
            app:popExitAnim="@anim/slide_out_up" />
        <action
            android:id="@+id/action_workoutDetailFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/slide_out_down"
            app:popEnterAnim="@anim/slide_in_up"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <!-- Exercise Detail Fragment -->
    <fragment
        android:id="@+id/exerciseDetailFragment"
        android:name="com.torto.trgym.ui.exercises.ExerciseDetailFragment"
        tools:layout="@layout/fragment_exercise_detail">
        <argument
            android:name="exerciseId"
            app:argType="integer" />
        <argument
            android:name="workoutCardId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_exerciseDetailFragment_to_exercisesFragment"
            app:destination="@id/exercisesFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
        <action
            android:id="@+id/action_exerciseDetailFragment_to_workoutDetailFragment"
            app:destination="@id/workoutDetailFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.torto.trgym.ui.auth.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_down" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.torto.trgym.ui.profile.ProfileFragment"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/slide_out_down"
            app:popEnterAnim="@anim/slide_in_up"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_profileFragment_to_workoutHistoryFragment"
            app:destination="@id/workoutHistoryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_profileFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/slide_out_up"
            app:popEnterAnim="@anim/slide_in_up"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_profileFragment_to_bodyMeasurementsFragment"
            app:destination="@id/bodyMeasurementsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/exercisesFragment"
        android:name="com.torto.trgym.ui.exercises.ExercisesFragment"
        tools:layout="@layout/fragment_exercises">
        <action
            android:id="@+id/action_exercisesFragment_to_exerciseDetailFragment"
            app:destination="@id/exerciseDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- ActiveWorkout Fragment -->
    <fragment
        android:id="@+id/activeWorkoutFragment"
        android:name="com.torto.trgym.ui.workout.ActiveWorkoutFragment"
        android:label="Allenamento in corso"
        tools:layout="@layout/fragment_active_workout">
        <argument
            android:name="workoutCardId"
            app:argType="string" />
        <action
            android:id="@+id/action_activeWorkoutFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/slide_out_down"
            app:popEnterAnim="@anim/slide_in_up"
            app:popExitAnim="@anim/fade_out"/>
    </fragment>

    <!-- Workout History Fragment -->
    <fragment
        android:id="@+id/workoutHistoryFragment"
        android:name="com.torto.trgym.ui.workout.WorkoutHistoryFragment"
        android:label="Storico Allenamenti"
        tools:layout="@layout/fragment_workout_history">
        <action
            android:id="@+id/action_workoutHistoryFragment_to_workoutSessionDetailFragment"
            app:destination="@id/workoutSessionDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_workoutHistoryFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
    </fragment>

    <!-- Workout Session Detail Fragment -->
    <fragment
        android:id="@+id/workoutSessionDetailFragment"
        android:name="com.torto.trgym.ui.workout.WorkoutSessionDetailFragment"
        android:label="Dettaglio Allenamento"
        tools:layout="@layout/fragment_workout_session_detail">
        <argument
            android:name="sessionId"
            app:argType="string" />
        <action
            android:id="@+id/action_workoutSessionDetailFragment_to_workoutHistoryFragment"
            app:destination="@id/workoutHistoryFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
    </fragment>

    <!-- Body Measurements Fragment -->
    <fragment
        android:id="@+id/bodyMeasurementsFragment"
        android:name="com.torto.trgym.ui.bodymeasurement.BodyMeasurementsFragment"
        android:label="Body Measurements"
        tools:layout="@layout/fragment_body_measurements">
        <action
            android:id="@+id/action_bodyMeasurementsFragment_to_measurementDetailFragment"
            app:destination="@id/measurementDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_bodyMeasurementsFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
    </fragment>

    <!-- Measurement Detail Fragment -->
    <fragment
        android:id="@+id/measurementDetailFragment"
        android:name="com.torto.trgym.ui.bodymeasurement.MeasurementDetailFragment"
        android:label="Measurement Detail"
        tools:layout="@layout/fragment_measurement_detail">
        <action
            android:id="@+id/action_measurementDetailFragment_to_bodyMeasurementsFragment"
            app:destination="@id/bodyMeasurementsFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
    </fragment>

</navigation>