<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="@dimen/box_inset_layout_padding"
    app:boxedEdges="all">

    <!-- Container principale con barra di scorrimento -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ScrollView principale -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="20dp"
                android:paddingHorizontal="16dp">

                <!-- Icona cuore con animazione -->
                <ImageView
                    android:id="@+id/heartIcon"
                    android:layout_width="@dimen/wear_icon_size"
                    android:layout_height="@dimen/wear_icon_size"
                    android:layout_marginBottom="16dp"
                    android:src="@drawable/heart_pulse"
                    android:contentDescription="Heart Rate Icon" />

                <!-- Display frequenza cardiaca -->
                <TextView
                    android:id="@+id/heartRateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- BPM"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/wear_text_size_extra_large"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium" />

                <!-- Container pulsanti con spaziatura ottimizzata -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="12dp">

                    <!-- Pulsante richiesta permessi -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/requestPermissionBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/wear_button_min_height"
                        android:text="Richiedi Permesso"
                        android:textSize="@dimen/wear_text_size_small"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_permission_bg"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:padding="8dp"
                        android:maxLines="3"
                        android:ellipsize="none"
                        android:lineSpacingMultiplier="1.1" />

                    <!-- Pulsante avvio servizio -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/startServiceBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/wear_button_min_height"
                        android:text="Start Monitoring"
                        android:textSize="@dimen/wear_text_size_small"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_start_bg"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        android:textAlignment="center"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:padding="8dp"
                        android:maxLines="2"
                        android:ellipsize="none"
                        android:lineSpacingMultiplier="1.1" />

                    <!-- Pulsante stop servizio -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/stopServiceBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/wear_button_min_height"
                        android:text="Stop Monitoring"
                        android:textSize="@dimen/wear_text_size_small"
                        android:textColor="#FFFFFF"
                        android:textAlignment="center"
                        android:background="@drawable/button_stop_bg"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:padding="8dp"
                        android:maxLines="2"
                        android:ellipsize="none"
                        android:lineSpacingMultiplier="1.1" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


    </RelativeLayout>

</androidx.wear.widget.BoxInsetLayout>