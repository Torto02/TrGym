<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- Back button e titolo esercizio -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="152dp"
            android:layout_height="40dp"
            android:drawableStart="@drawable/arrow_back"
            android:paddingLeft="10dp"
            android:text="Esercizi"
            android:textColor="#3F3DFF"
            android:textSize="30sp"
            android:gravity="center_vertical"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/exerciseName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="Nome esercizio"
            android:textColor="#3F3DFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/favoriteStar"
            app:layout_constraintTop_toBottomOf="@id/backButton" />

        <ImageView
            android:id="@+id/favoriteStar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/btn_star_big_off"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/exerciseName" />

        <!-- Sezione GIF in MaterialCardView -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExerciseGif"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toBottomOf="@id/exerciseName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="16dp"
            app:strokeColor="#7CDDDDDD"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/exerciseGif"
                android:layout_width="match_parent"
                android:layout_height="228dp"
                android:background="@android:color/white"
                android:contentDescription="GIF dell'esercizio"
                android:scaleType="fitCenter"
                tools:src="@tools:sample/avatars" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Sezione Primer -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPrimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toBottomOf="@id/cardExerciseGif"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="16dp"
            app:strokeColor="#7CDDDDDD"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/primer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Primer: breve spiegazione"
                android:textSize="16sp"
                android:background="@color/white" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Sezione Muscoli coinvolti -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMuscles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSteps"
            app:strokeColor="#7CDDDDDD"
            app:strokeWidth="1dp">


            <TextView
                android:id="@+id/musclesInvolved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Muscoli coinvolti: Muscle1, Muscle2"
                android:textSize="16sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>


        <!-- Sezione Step: titolo + contenuto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSteps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="18dp"
            app:layout_constraintTop_toBottomOf="@id/cardPrimer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="16dp"
            app:strokeColor="#7CDDDDDD"
            app:strokeWidth="1dp"
            android:backgroundTint="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/stepTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step:"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. Qui ci sarà la descrizione dell'esercizio\n2. step by step\n....."
                    android:textSize="16sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
