<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="12dp"
    android:gravity="center_vertical">

    <!-- Numero del set -->
    <TextView
        android:id="@+id/setNumber"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="Set 1"
        android:textSize="14sp"
        android:textColor="@color/ios_label"
        android:gravity="center"
        tools:text="Set 1" />

    <!-- Valori target (peso e ripetizioni) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/targetWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80kg"
                android:textSize="14sp"
                android:textColor="@color/ios_secondaryLabel"
                android:layout_marginEnd="4dp"
                tools:text="80kg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×"
                android:textSize="14sp"
                android:textColor="@color/ios_secondaryLabel"
                android:layout_marginHorizontal="2dp" />

            <TextView
                android:id="@+id/targetReps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textSize="14sp"
                android:textColor="@color/ios_secondaryLabel"
                android:layout_marginStart="4dp"
                tools:text="12" />

        </LinearLayout>

    </LinearLayout>

    <!-- Valori eseguiti (peso e ripetizioni) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/actualWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80kg"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ios_label"
                android:layout_marginEnd="4dp"
                tools:text="80kg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×"
                android:textSize="14sp"
                android:textColor="@color/ios_label"
                android:layout_marginHorizontal="2dp" />

            <TextView
                android:id="@+id/actualReps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ios_label"
                android:layout_marginStart="4dp"
                tools:text="10" />

        </LinearLayout>

    </LinearLayout>

    <!-- Indicatore di completamento -->
    <TextView
        android:id="@+id/setStatus"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center"
        tools:text="✓" />

</LinearLayout>