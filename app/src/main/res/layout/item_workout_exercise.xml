<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/exerciseCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/lightGray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header dell'esercizio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Drag Handle (visibile solo in modalità edit) -->
            <ImageView
                android:id="@+id/dragHandle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_drag"
                android:visibility="gone"
                app:tint="@color/ios_secondaryLabel"
                tools:visibility="visible" />

            <!-- Status Icon (completato/in corso) -->
            <ImageView
                android:id="@+id/exerciseStatusIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                app:tint="@color/ios_secondaryLabel"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/exercisePreviewIcon"
                tools:src="@tools:sample/avatars"
                android:layout_width="70dp"
                android:elevation="12dp"
                android:layout_height="70dp"
                android:layout_marginEnd="12dp"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/exerciseInfoLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Nome esercizio -->
                <TextView
                    android:id="@+id/exerciseName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Panca piana"
                    android:textColor="@color/ios_label"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"
                    tools:text="Panca piana" />

                <!-- Informazioni esercizio -->
                <TextView
                    android:id="@+id/exerciseInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 serie • Petto, Tricipiti"
                    android:textColor="@color/ios_secondaryLabel"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    tools:text="3 serie • Petto, Tricipiti" />

            </LinearLayout>

            <!-- Menu esercizio -->
            <ImageView
                android:id="@+id/exerciseMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="@color/ios_secondaryLabel" />

        </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:id="@+id/setsHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="5dp"
            android:layout_marginBottom="4dp"
            android:background="@color/transparent"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/exerciseInfo">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="Serie"
                android:textColor="@color/ios_secondaryLabel"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Peso (kg)"
                android:textColor="@color/ios_secondaryLabel"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reps"
                android:textColor="@color/ios_secondaryLabel"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />




        </LinearLayout>

</com.google.android.material.card.MaterialCardView>

        <!-- Lista serie -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/setsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="true"
            tools:listitem="@layout/item_exercise_set" />

        <!-- Pulsante Aggiungi Serie -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addSetButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="+ Aggiungi Serie"
            android:textColor="@color/primary"
            android:textSize="14sp"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- Rest Timer (visibile durante allenamento tra le serie) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/restTimerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/primary"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_timer"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Riposo"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/restTimerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01:30"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="01:30" />

                <ImageView
                    android:id="@+id/skipRestButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_skip"
                    app:tint="@color/white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>