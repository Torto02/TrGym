<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/lightGray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header esercizio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/exerciseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Esercizio 1"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Panca piana" />

            <ImageView
                android:id="@+id/expandCollapseIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_equipment"
                android:contentDescription="Espandi/Comprimi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/ios_secondaryLabel" />

        </LinearLayout>

        <!-- Container per i set (inizialmente collassato) -->
        <LinearLayout
            android:id="@+id/setsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header tabella -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Serie"
                    android:textColor="@color/ios_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kg"
                    android:textColor="@color/ios_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reps"
                    android:textColor="@color/ios_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Container per i set dinamici -->
            <LinearLayout
                android:id="@+id/dynamicSetsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Set di esempio (saranno aggiunti dinamicamente) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1"
                        android:textColor="@color/ios_secondaryLabel"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:padding="8dp" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:gravity="center"
                        android:hint="0"
                        android:inputType="numberDecimal"
                        android:textSize="14sp"
                        android:textColor="@color/ios_label" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:gravity="center"
                        android:hint="0"
                        android:inputType="number"
                        android:textSize="14sp"
                        android:textColor="@color/ios_label" />

                </LinearLayout>

            </LinearLayout>

            <!-- Pulsante Aggiungi Serie -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addSetBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aggiungi Serie"
                android:textColor="@color/primary"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.TextButton"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/primary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>