<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:backgroundTint="@color/white">

    <!-- Bottone filtro Muscles -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFilterMuscles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/all_muscles"
        app:cornerRadius="20dp"
        android:backgroundTint="#234DE7"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnFilterEquipment"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="8dp" />

    <!-- Bottone filtro Equipment -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFilterEquipment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/all_equipment"
        app:cornerRadius="20dp"
        android:backgroundTint="#234DE7"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toEndOf="@+id/btnFilterMuscles"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="8dp" />

    <!-- Container per la lista con bordi arrotondati -->
    <androidx.cardview.widget.CardView
        android:id="@+id/list_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/btnFilterMuscles"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- RecyclerView degli esercizi -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExercises"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>