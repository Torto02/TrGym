<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header con nome e menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Icona categoria workout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/workoutCategoryIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_muscle"
                    app:tint="@color/primary" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/workoutCardName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giorno 1 - Push"
                    android:textColor="@color/ios_label"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Giorno 1 - Push" />

                <TextView
                    android:id="@+id/workoutCardSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ios_secondaryLabel"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    tools:text="Petto, Spalle, Tricipiti" />

            </LinearLayout>

            <!-- Menu con design moderno -->
            <ImageView
                android:id="@+id/workoutCardMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="8dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Menu"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/ios_secondaryLabel" />

        </LinearLayout>

        <!-- Descrizione con stile migliorato -->
        <TextView
            android:id="@+id/workoutCardDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allenamento focalizzato sui muscoli di spinta del corpo superiore"
            android:textColor="@color/ios_secondaryLabel"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="16dp"
            android:visibility="visible"
            tools:text="Allenamento focalizzato sui muscoli di spinta del corpo superiore" />


        <!-- Info esercizi con design cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Esercizi card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_fitness_center"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/exerciseCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 esercizi"
                    android:textColor="@color/ios_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="6 esercizi" />

            </LinearLayout>

            <!-- Ultimo allenamento card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    app:tint="@color/ios_secondaryLabel" />

                <TextView
                    android:id="@+id/lastWorkout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 giorni fa"
                    android:textColor="@color/ios_secondaryLabel"
                    android:textSize="13sp"
                    tools:text="2 giorni fa" />

            </LinearLayout>

        </LinearLayout>

        <!-- Badge per difficoltà -->
        <LinearLayout
            android:id="@+id/badgesLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible">


        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>