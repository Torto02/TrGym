<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/lightGray"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header con nome e menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/workoutCardName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Giorno 1"
                android:textColor="@color/ios_label"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Giorno 1" />

            <ImageView
                android:id="@+id/workoutCardMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/ios_secondaryLabel" />

        </LinearLayout>

        <!-- Descrizione -->
        <TextView
            android:id="@+id/workoutCardDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allenamento completo per il corpo"
            android:textColor="@color/ios_secondaryLabel"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:text="Allenamento completo per il corpo"
            tools:visibility="visible" />

        <!-- Info esercizi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_fitness_center" />

            <TextView
                android:id="@+id/exerciseCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 esercizi"
                android:textSize="12sp"
                tools:text="5 esercizi" />

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/circle" />

            <TextView
                android:id="@+id/lastWorkout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultimo: 2 giorni fa"
                android:textSize="12sp"
                tools:text="Ultimo: 2 giorni fa" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>