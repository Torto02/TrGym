<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_systemBackground">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ios_systemBackground"
        android:elevation="3dp">

        <!-- Back Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:clickable="true"
            android:contentDescription="@string/backBtn"
            android:text="@string/backBtn"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_ios_back"
            android:backgroundTint="#80FFFFFF"
            app:iconTint="@color/primary"
            app:strokeColor="@color/lightGray"
            app:strokeWidth="1dp"
            app:cornerRadius="30dp"
            app:iconGravity="start"
            style="@style/Widget.Material3.Button.TextButton"
            android:paddingHorizontal="16dp" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Contenuto scrollabile -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="?attr/actionBarSize"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <!-- Header con dettagli del workout -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="@color/lightGray">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Titolo workout -->
                    <TextView
                        android:id="@+id/workoutTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allenamento Push"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/ios_label"
                        android:layout_marginBottom="12dp"
                        tools:text="Allenamento Push" />

                    <!-- Data e ora -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_email"
                            app:tint="@color/primary"
                            android:layout_marginEnd="8dp"
                            android:layout_gravity="center_vertical" />

                        <TextView
                            android:id="@+id/workoutDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lunedì, 15 Gennaio 2024 alle 18:30"
                            android:textSize="16sp"
                            android:textColor="@color/ios_secondaryLabel"
                            tools:text="Lunedì, 15 Gennaio 2024 alle 18:30" />

                    </LinearLayout>

                    <!-- Durata -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">



                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/primary"
                            android:layout_marginEnd="8dp"
                            android:layout_gravity="center_vertical" />

                        <TextView
                            android:id="@+id/workoutDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Durata: 1h 23m"
                            android:textSize="16sp"
                            android:textColor="@color/ios_secondaryLabel"
                            tools:text="Durata: 1h 23m" />


                    </LinearLayout>

                    <!-- Note del workout (opzionale) -->
                    <TextView
                        android:id="@+id/workoutNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Note del workout"
                        android:textSize="14sp"
                        android:textColor="@color/ios_secondaryLabel"
                        android:backgroundTint="@color/ios_systemGray6"
                        android:padding="12dp"
                        android:visibility="gone"
                        tools:text="Ottimo allenamento, mi sono sentito molto energico oggi"
                        tools:visibility="visible" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sezione Esercizi -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esercizi Eseguiti"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/ios_label"
                android:layout_marginBottom="12dp" />

            <!-- RecyclerView per gli esercizi -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/exercisesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_workout_session_exercise" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="48dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    android:src="@drawable/ic_fitness_center"
                    app:tint="@color/ios_secondaryLabel" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nessun esercizio registrato"
                    android:textColor="@color/ios_secondaryLabel"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Non sono stati trovati esercizi per questo allenamento"
                    android:textColor="@color/ios_secondaryLabel"
                    android:textSize="14sp"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>