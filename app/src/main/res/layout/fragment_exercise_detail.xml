<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/ios_systemBackground">

    <!-- Immagine fissa in alto -->
    <ImageView
        android:id="@+id/detailImage"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="?attr/actionBarSize"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/exercise_image_desc"
        tools:src="@tools:sample/avatars" />

    <!-- Toolbar trasparente -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="4dp">
        <ImageView
            android:id="@+id/starButton"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="@string/favorite_button_desc"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:elevation="20dp"
            android:layout_marginEnd="20dp"
            app:tint="@color/ios_secondaryLabel" />


        <!-- Back Button a sinistra -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:clickable="true"
            android:contentDescription="@string/backBtn"
            android:text="@string/backBtn"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_ios_back"
            android:backgroundTint="#80FFFFFF"
            app:iconTint="@color/primary"
            app:strokeColor="@color/lightGray"
            app:strokeWidth="1dp"
            app:cornerRadius="30dp"
            app:iconGravity="start"
            style="@style/Widget.Material3.Button.TextButton"
            android:paddingHorizontal="16dp" />

    </com.google.android.material.appbar.MaterialToolbar>


    <!-- Pulsante Indietro -->


    <!-- Contenuto scrollabile -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollExerciseDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="380dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false">

        <!-- Card contenuto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="100dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="30dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/lightGray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <!-- Titolo esercizio -->
                <TextView
                    android:id="@+id/detailName"
                    android:text="@string/ex_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ios_label"
                    android:textSize="28sp" />

                <!-- Badge tipo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/typeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/ios_systemBlue_light">

                    <TextView
                        android:id="@+id/detailType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textColor="#001EFF"
                        android:text="@string/exercise_type"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="#DDDDDD" />

                <!-- Sezione Tips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_description"
                        app:tint="#FF5722" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/labelTips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tips_label"
                            android:textColor="@color/ios_label"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailTips"
                            android:text="@string/tips_label"
                            style="@style/TextAppearance.IOS.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/ios_secondaryLabel" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card Muscoli -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@color/ios_systemBlue_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_muscle"
                            app:tint="#E90000" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/labelMuscles"
                                style="@style/TextAppearance.IOS.LabelSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/muscles_label"
                                android:textColor="@color/ios_label" />

                            <TextView
                                android:id="@+id/detailMuscles"
                                android:text="@string/muscles_label"
                                style="@style/TextAppearance.IOS.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/ios_secondaryLabel" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Attrezzatura -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@color/ios_systemBlue_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_equipment"
                            app:tint="#8BC34A" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/labelEquipment"
                                style="@style/TextAppearance.IOS.LabelSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/equipment_label"
                                android:textColor="@color/ios_label" />

                            <TextView
                                android:id="@+id/detailEquipment"
                                style="@style/TextAppearance.IOS.Body"
                                android:text="@string/equipment_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/ios_secondaryLabel" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
