<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workoutSessionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginHorizontal="2dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header con nome e status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">



            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/workoutName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allenamento Push"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/ios_label"
                    android:layout_marginBottom="4dp"
                    tools:text="Allenamento Push" />

                <TextView
                    android:id="@+id/exerciseCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 esercizi • 18 serie"
                    android:textSize="13sp"
                    android:textColor="@color/ios_secondaryLabel"
                    android:alpha="0.8"
                    tools:text="5 esercizi • 18 serie" />

            </LinearLayout>

            <!-- Status badge migliorato -->
            <LinearLayout
                android:id="@+id/statusContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:orientation="horizontal"
                android:gravity="center">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/workoutStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completato"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Completato" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divisore sottile -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.3" />

        <!-- Info dettagliate con icone migliorate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Data e ora -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:tint="@color/primary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:alpha="0.7" />

                    <TextView
                        android:id="@+id/workoutDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 Gen"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/ios_label"
                        tools:text="15 Gen" />

                </LinearLayout>

            </LinearLayout>

            <!-- Durata -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/primary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Durata"
                        android:textSize="10sp"

                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:alpha="0.7" />

                    <TextView
                        android:id="@+id/workoutDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1h 23m"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/ios_label"
                        tools:text="1h 23m" />

                </LinearLayout>

            </LinearLayout>

            <!-- Volume totale -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:tint="@color/primary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Volume"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:alpha="0.7" />

                    <TextView
                        android:id="@+id/workoutVolume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.1k kg"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/ios_label"
                        tools:text="2.1k kg" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>