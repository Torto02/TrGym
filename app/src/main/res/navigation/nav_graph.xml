<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.torto.trgym.ui.auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.torto.trgym.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_exercises"
            app:destination="@id/exercisesFragment"
            app:restoreState="true" />
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment"
            app:restoreState="true" />
        <action
            android:id="@+id/action_home_to_workoutDetail"
            app:destination="@id/workoutDetailFragment" />

        <action
            android:id="@+id/action_home_to_freeWorkout"
            app:destination="@id/freeWorkoutFragment" />
        <action
            android:id="@+id/action_homeFragment_to_activeWorkoutFragment"
            app:destination="@id/activeWorkoutFragment"

             />
    </fragment>

    <!-- Workout Detail Fragment -->
    <fragment
        android:id="@+id/workoutDetailFragment"
        android:name="com.torto.trgym.ui.home.WorkoutDetailFragment"
        tools:layout="@layout/fragment_workout_detail">

        <argument
            android:name="workoutCardId"
            app:argType="string" />
        <action
            android:id="@+id/action_workoutDetailFragment_to_exerciseDetailFragment"
            app:destination="@id/exerciseDetailFragment" />

        <!-- Add this action to navigate from WorkoutDetailFragment to ActiveWorkoutFragment -->
        <action
            android:id="@+id/action_workoutDetailFragment_to_activeWorkoutFragment"
            app:destination="@id/activeWorkoutFragment" />


    </fragment>

    <!-- Exercise Detail Fragment (existing) -->
    <fragment
        android:id="@+id/exerciseDetailFragment"
        android:name="com.torto.trgym.ui.exercises.ExerciseDetailFragment"
        tools:layout="@layout/fragment_exercise_detail">
        <argument
            android:name="exerciseId"
            app:argType="integer" />
        <action
            android:id="@+id/action_exerciseDetailFragment_to_exercisesFragment"
            app:destination="@id/exercisesFragment" />
    </fragment>

    <!-- Free Workout Fragment (placeholder) -->
    <fragment
        android:id="@+id/freeWorkoutFragment" />


    <fragment
        android:id="@+id/registerFragment"
        android:name="com.torto.trgym.ui.auth.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.torto.trgym.ui.profile.ProfileFragment"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/exercisesFragment"
        android:name="com.torto.trgym.ui.exercises.ExercisesFragment"
        tools:layout="@layout/fragment_exercises">
        <action
            android:id="@+id/action_exercisesFragment_to_exerciseDetailFragment"
            app:destination="@id/exerciseDetailFragment"
            />
    </fragment>

    <!-- Add the ActiveWorkoutFragment destination -->
    <fragment
        android:id="@+id/activeWorkoutFragment"
        android:name="com.torto.trgym.ui.workout.ActiveWorkoutFragment"
        android:label="Allenamento in corso"
        tools:layout="@layout/fragment_active_workout">
        <argument
            android:name="workoutCardId"
            app:argType="string" />
        <action
            android:id="@+id/action_activeWorkoutFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

